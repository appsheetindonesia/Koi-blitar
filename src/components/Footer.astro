---
import { site, waLink } from '../data/site';
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__col">
        <p class="foot__label">Farm</p>
        <p>
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </p>
        <p class="foot__note">
          Dua titik kandang di Modangan: kantor I dan MaBes Duta Koi II. Kunjungan
          sebaiknya menghubungi kami dulu agar ada yang mendampingi.
        </p>
      </div>

      <div class="foot__col">
        <p class="foot__label">Kontak</p>
        <p>
          <a href={waLink('Halo Duta Koi Blitar, saya mau tanya stok koi.')}>{site.waDisplay}</a><br />
          <a href="/kontak-kami">Halaman kontak</a>
        </p>
        <p class="foot__note">{site.hours}</p>
      </div>

      <div class="foot__col">
        <p class="foot__label">Pembayaran</p>
        <p>
          DP 50% saat deal, pelunasan paling lambat 2 hari sebelum pengiriman.
        </p>
        <p class="foot__note">
          Transfer hanya ke {site.bank.name} {site.bank.account} a.n. {site.bank.holder}.
          Rekening lain bukan tanggung jawab kami.
        </p>
      </div>
    </div>

    <div class="foot__base">
      <p>© {new Date().getFullYear()} Duta Koi Blitar</p>
      <p class="foot__base-links">
        <a href="/paket-bibitan">Bibitan</a>
        <a href="/paket-borongan">Borongan</a>
        <a href="/paket-custome">Mix custom</a>
        <a href="/paket-satuan">Satuan</a>
        <a href="/tentang-kami">Tentang kami</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--ink);
    padding-block: 3rem 2rem;
    font-size: 0.94rem;
  }

  .foot__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.3fr;
    gap: 2.5rem;
  }

  .foot__label {
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent-ink);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .foot__note {
    color: var(--ink-faint);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-top: 0.7rem;
  }

  .foot a {
    color: var(--ink);
  }

  .foot__base {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .foot__base p {
    margin: 0;
  }

  .foot__base-links {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  .foot__base-links a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .foot__base-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .foot__grid {
      grid-template-columns: 1fr;
      gap: 1.9rem;
    }
  }
</style>
