---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  {
    href: '/',
    label: 'Beranda',
    icon: '<path d="M4 11.2 12 4.6l8 6.6"/><path d="M6.4 9.9v9.3h11.2V9.9"/><path d="M10.3 19.2v-4.4h3.4v4.4"/>',
  },
  {
    href: '/paket-bibitan',
    label: 'Bibitan',
    icon: '<path d="M12 19.6v-6.8"/><path d="M12 12.8c0-3.2 2.3-5.4 5.6-5.4 0 3.2-2.3 5.4-5.6 5.4Z"/><path d="M12 15c0-2.6-1.9-4.5-4.6-4.5 0 2.6 1.9 4.5 4.6 4.5Z"/>',
  },
  {
    href: '/paket-borongan',
    label: 'Borongan',
    icon: '<path d="M3.8 8.3h16.4v10.1H3.8z"/><path d="M3.8 8.3 5.9 5.2h12.2l2.1 3.1"/><path d="M9.9 12.2h4.2"/>',
  },
  {
    href: '/paket-custome',
    label: 'Mix',
    icon: '<circle cx="9.4" cy="12" r="4.6"/><circle cx="14.6" cy="12" r="4.6"/>',
  },
  {
    href: '/paket-satuan',
    label: 'Satuan',
    icon: '<path d="M8.6 8.1c3.9 0 7 1.7 9.1 3.9-2.1 2.2-5.2 3.9-9.1 3.9-1.9 0-3.4-1.7-3.4-3.9S6.7 8.1 8.6 8.1Z"/><path d="M5.2 12 2.6 9.5v5z"/><circle cx="14.4" cy="11.1" r=".9"/>',
  },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="tabbar" aria-label="Navigasi cepat">
  {tabs.map((t) => (
    <a href={t.href} class="tabbar__tab" aria-current={isActive(t.href) ? 'page' : undefined}>
      <svg
        class="tabbar__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={t.icon}
      />
      <span class="tabbar__label">{t.label}</span>
    </a>
  ))}
</nav>

<style>
  /* Hanya untuk layar sempit; di desktop navigasi utama di header sudah cukup. */
  .tabbar {
    display: none;
  }

  @media (max-width: 720px) {
    .tabbar {
      position: fixed;
      left: 0.6rem;
      right: 0.6rem;
      bottom: calc(var(--tabbar-gap) + env(safe-area-inset-bottom, 0px));
      z-index: 30;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.15rem;
      padding: 0.3rem;
      background: var(--paper);
      border: 1px solid var(--rule-strong);
      border-radius: 999px;
      box-shadow: 0 10px 24px -20px rgba(23, 20, 15, 0.55);
    }

    .tabbar__tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.18rem;
      min-height: 3rem;
      padding: 0.35rem 0.1rem;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-align: center;
      text-decoration: none;
      color: var(--ink-faint);
      transition: color 140ms ease, background-color 140ms ease;
    }

    .tabbar__icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .tabbar__tab:hover {
      color: var(--ink);
    }

    .tabbar__tab[aria-current='page'] {
      color: var(--ink);
      background: var(--paper-deep);
      font-weight: 600;
    }

    .tabbar__tab[aria-current='page'] .tabbar__icon {
      color: var(--accent);
    }
  }
</style>
