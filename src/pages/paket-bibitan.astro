---
import PaketPage from '../layouts/PaketPage.astro';
import PaketTable from '../components/PaketTable.astro';
import WaButton from '../components/WaButton.astro';
import { paketBibitan } from '../data/site';
---

<PaketPage
  title="Paket Bibitan Koi — 20 sampai 100 ekor | Duta Koi Blitar"
  description="Paket bibitan koi dari farm Modangan, Blitar: 20, 30, 50, dan 100 ekor ukuran 10–20 cm, grade random sampai A. Cocok untuk pembesaran dan jualan lagi."
  heading="Bibit untuk kolam yang baru mulai"
  intro="Anakan disortir berdasarkan ukuran lalu dikelompokkan per jumlah. Untuk satu kolam pembesaran, 20–30 ekor sudah cukup; pengepul biasanya mengambil 50–100 ekor sekaligus."
  image="/img/bibitan-anakan.webp"
  imageAlt="Puluhan anakan koi aneka warna di ember biru"
  waMessage="Halo Duta Koi Blitar, saya mau tanya paket bibitan. Rencana ambil ... ekor untuk kolam ukuran ... meter."
  waLabel="Tanya stok bibitan"
  caption="Anakan siap kirim, difoto di ember sortir farm. Warna dan corak mengikuti stok yang ada."
>
  <section class="section">
    <div class="rule-head">
      <h2>Empat ukuran paket</h2>
      <p class="small" style="margin:0">Harga per paket, bukan per ekor.</p>
    </div>
    <PaketTable items={paketBibitan} kategori="paket bibitan" />
  </section>

  <section class="section">
    <div class="split">
      <div>
        <h2>Bedanya grade A dan grade random</h2>
        <p>
          Paket 20 dan 30 ekor berisi ikan <strong>grade A</strong> ukuran 15–20
          cm. Kalau Anda ingin menyeleksi sendiri calon indukan atau ikan
          kontes, mulai dari jumlah kecil seperti ini lebih masuk akal: ikan
          lebih sedikit, tapi bisa Anda amati satu per satu.
        </p>
        <p>
          Paket 50 dan 100 ekor memakai <strong>grade random</strong> dengan
          rentang ukuran lebih lebar: 10–14 cm untuk 100 ekor, 15–20 cm untuk 50
          ekor. Variasinya lebih banyak dan harga per ekor lebih ringan, tetapi
          Anda perlu menyiapkan kolam dan pakan lebih banyak sejak hari pertama.
        </p>
      </div>
      <div class="split__aside">
        <h3>Sebelum memesan, siapkan</h3>
        <ul class="check">
          <li>Kolam atau bak karantina terpisah minimal 2 minggu</li>
          <li>Air yang sudah diendapkan, bukan air PDAM langsung</li>
          <li>Pakan ukuran kecil untuk 10–15 cm pertama</li>
          <li>Rencana seleksi: mana yang dijual, mana yang dipelihara</li>
        </ul>
        <WaButton
          label="Tanya stok bibitan"
          message="Halo Duta Koi Blitar, saya mau tanya paket bibitan. Rencana ambil ... ekor untuk kolam ukuran ... meter. Stok dan harganya bagaimana?"
        />
      </div>
    </div>
  </section>
</PaketPage>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .split h2 {
    margin-bottom: 1.1rem;
  }

  .split__aside {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1rem, 2vw, 2rem);
  }

  .split__aside h3 {
    margin-bottom: 0.9rem;
  }

  .check {
    list-style: none;
    margin-bottom: 1.6rem;
    font-size: 0.94rem;
  }

  .check li {
    padding-block: 0.55rem 0.55rem 1.4rem;
    border-bottom: 1px solid var(--rule);
    padding-left: 1.15rem;
    position: relative;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .check li:last-child {
    border-bottom: 0;
  }

  .check li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split__aside {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
      padding-top: 1.4rem;
    }
  }
</style>
